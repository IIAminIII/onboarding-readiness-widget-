// Check Onboarding Readiness
// Deluge function for the Easy Client Onboarding Tracker extension.
// Deployed in Zoho CRM / Sigma, not from this repo. Kept here as the
// authoritative copy of the working version.
//
// Two things this depends on:
//   1. The rules module API name is SINGULAR: ..._Onboarding_Readiness_Rule
//   2. Record IDs must be passed to the CRM functions as long, not text.

dealId = "";
if(deal != null)
{
	if(deal.get("id") != null)
	{
		dealId = deal.get("id").toString();
	}
	else if(deal.get("Deals.ID") != null)
	{
		dealId = deal.get("Deals.ID").toString();
	}
}
if(dealId == "")
{
	return "Deal ID is empty. Cannot check onboarding readiness.";
}
// Fetch Deal
dealResp = zoho.crm.getRecordById("Deals",dealId.toLong());
if(dealResp == null || dealResp.get("id") == null)
{
	return "Deal not found.";
}
// Rule module API name
ruleModuleApiName = "easyclientonboardingtracker__Onboarding_Readiness_Rule";
// Fetch readiness rules
rulesResponse = zoho.crm.getRecords(ruleModuleApiName,1,200);
// Normalize rules response
rulesList = List();
if(rulesResponse != null)
{
	responseText = rulesResponse.toString();
	if(responseText.contains("data"))
	{
		if(rulesResponse.get("data") != null)
		{
			rulesList = rulesResponse.get("data");
		}
	}
	else
	{
		rulesList = rulesResponse;
	}
}
if(rulesList == null || rulesList.size() == 0)
{
	return "No onboarding readiness rules found. Please create rule records first.";
}
score = 0;
totalScore = 0;
missingFields = List();
activeRulesCount = 0;
debugRulesChecked = 0;
// Loop through rules
for each  ruleRecord in rulesList
{
	ruleText = ruleRecord.toString();
	isActive = false;
	isRequired = false;
	targetModule = "";
	fieldApiName = "";
	fieldLabel = "";
	missingMessage = "";
	scoreWeight = 0;
	if(ruleText.contains("easyclientonboardingtracker__Active"))
	{
		isActive = ifnull(ruleRecord.get("easyclientonboardingtracker__Active"),false);
	}
	if(ruleText.contains("easyclientonboardingtracker__Required"))
	{
		isRequired = ifnull(ruleRecord.get("easyclientonboardingtracker__Required"),false);
	}
	if(ruleText.contains("easyclientonboardingtracker__Target_Module"))
	{
		targetModule = ifnull(ruleRecord.get("easyclientonboardingtracker__Target_Module"),"");
	}
	if(ruleText.contains("easyclientonboardingtracker__Field_API_Name"))
	{
		fieldApiName = ifnull(ruleRecord.get("easyclientonboardingtracker__Field_API_Name"),"");
	}
	if(ruleText.contains("easyclientonboardingtracker__Field_Label"))
	{
		fieldLabel = ifnull(ruleRecord.get("easyclientonboardingtracker__Field_Label"),"");
	}
	if(ruleText.contains("easyclientonboardingtracker__Missing_Field_Message"))
	{
		missingMessage = ifnull(ruleRecord.get("easyclientonboardingtracker__Missing_Field_Message"),"");
	}
	if(ruleText.contains("easyclientonboardingtracker__Score_Weight"))
	{
		scoreWeight = ifnull(ruleRecord.get("easyclientonboardingtracker__Score_Weight"),0);
	}
	isActiveText = isActive.toString().toLowerCase();
	isRequiredText = isRequired.toString().toLowerCase();
	targetModuleText = targetModule.toString().trim();
	isActiveValid = false;
	isRequiredValid = false;
	targetModuleValid = false;
	if(isActive == true || isActiveText == "true" || isActiveText == "yes" || isActiveText == "1")
	{
		isActiveValid = true;
	}
	if(isRequired == true || isRequiredText == "true" || isRequiredText == "yes" || isRequiredText == "1")
	{
		isRequiredValid = true;
	}
	if(targetModuleText == "Deals" || targetModuleText == "Deal" || targetModuleText == "Potentials")
	{
		targetModuleValid = true;
	}
	if(isActiveValid == true && isRequiredValid == true && targetModuleValid == true && fieldApiName != "")
	{
		activeRulesCount = activeRulesCount + 1;
		totalScore = totalScore + scoreWeight;
		fieldValue = null;
		dealText = dealResp.toString();
		if(dealText.contains(fieldApiName))
		{
			fieldValue = dealResp.get(fieldApiName);
		}
		isValueFilled = false;
		if(fieldValue != null)
		{
			fieldValueText = fieldValue.toString();
			if(fieldValueText != "" && fieldValueText != "null" && fieldValueText != "{}" && fieldValueText != "[]")
			{
				isValueFilled = true;
			}
		}
		if(isValueFilled == true)
		{
			score = score + scoreWeight;
		}
		else
		{
			if(missingMessage != "")
			{
				missingFields.add(missingMessage);
			}
			else if(fieldLabel != "")
			{
				missingFields.add(fieldLabel);
			}
			else
			{
				missingFields.add(fieldApiName);
			}
		}
	}
	else
	{
		debugRulesChecked = debugRulesChecked + 1;
	}
}
if(totalScore == 0)
{
	return "No active required readiness rules found for Deals. Please check that rule records have Active checked, Required checked, Target Module set to Deals, and Field API Name filled.";
}
// Calculate readiness percentage
readinessScore = ((score * 100) / totalScore).round(0);
// Decide readiness level
readinessLevel = "";
onboardingStatus = "";
if(readinessScore >= 90)
{
	readinessLevel = "Ready";
	onboardingStatus = "Ready for Onboarding";
}
else if(readinessScore >= 60)
{
	readinessLevel = "Needs Review";
	onboardingStatus = "Missing Information";
}
else
{
	readinessLevel = "Incomplete";
	onboardingStatus = "Missing Information";
}
// Prepare missing fields text
missingText = "";
for each  fieldName in missingFields
{
	if(missingText == "")
	{
		missingText = fieldName;
	}
	else
	{
		missingText = missingText + ", " + fieldName;
	}
}
// Update Deal
updateMap = Map();
updateMap.put("easyclientonboardingtracker__Onboarding_Readiness_Score",readinessScore);
updateMap.put("easyclientonboardingtracker__Onboarding_Readiness_Level",readinessLevel);
updateMap.put("easyclientonboardingtracker__Missing_Onboarding_Fields",missingText);
updateMap.put("easyclientonboardingtracker__Onboarding_Status",onboardingStatus);
updateResp = zoho.crm.updateRecord("Deals",dealId.toLong(),updateMap);
// Final button message
if(missingText == "")
{
	return "Onboarding readiness checked successfully. Score: " + readinessScore + "%. Level: " + readinessLevel + ". Active Rules: " + activeRulesCount + ". No missing fields. This Deal is ready for onboarding.";
}
else
{
	return "Onboarding readiness checked successfully. Score: " + readinessScore + "%. Level: " + readinessLevel + ". Active Rules: " + activeRulesCount + ". Missing Fields: " + missingText;
}
